{
  "name": "@telinha/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@telinha/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@telinha/shared": "workspace:*",
    "hono": "^4.13.8",
    "hono-rate-limiter": "^0.5.4",
    "livekit-server-sdk": "^2.19.1",
    "nanoid": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
