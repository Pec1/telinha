# Copie para .env apenas se for rodar fora do Codespaces.
# No Codespaces e no Render estes valores vêm de secrets / variáveis de ambiente.

# URL do projeto no LiveKit Cloud (wss://<projeto>.livekit.cloud)
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
# Credenciais da API do LiveKit Cloud (Settings > Keys)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Segredo para assinar o sessionKey (HMAC-SHA256). Gere com: openssl rand -base64 32
SESSION_SECRET=

# Porta HTTP do server (o Render define automaticamente)
PORT=8787
# Máximo de participantes por sala
MAX_PARTICIPANTS=25
# Máximo de pessoas com permissão de tela por sala, contando o host
MAX_SHARERS=4
# Segundos até uma sala vazia ser encerrada
EMPTY_TIMEOUT_SECONDS=300
# Segundos de carência antes de promover um novo host quando o host sai
HOST_GRACE_SECONDS=20
# Rate limit por IP (on/off). Use off só em testes automatizados.
RATE_LIMIT=on
